#!/usr/bin/env bash
# Refuse any push to refs/heads/main, then run the gate-wiring check (blocking, a few seconds).
# Each step skips silently when its tooling is absent in this worktree. The wiring check asks
# vitest, pytest and rspec for their file lists, so it needs .venv, node_modules and
# ruby/vendor/bundle (make deps).
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd -P)"
guard="$root/scripts/guard_main.sh"
[ -f "$guard" ] || exit 0
. "$guard"
guard_main_push
if [ -x "$root/.venv/bin/python" ] && [ -d "$root/node_modules" ] && [ -d "$root/ruby/vendor/bundle" ] \
   && [ -f "$root/scripts/check_gate_wiring.py" ]; then
  make -C "$root" -s gate-wiring-check
else
  echo "pre-push: no .venv, node_modules or ruby/vendor/bundle in this worktree; skipping gate-wiring-check" >&2
fi
