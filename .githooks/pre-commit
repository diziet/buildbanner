#!/usr/bin/env bash
# Refuse commits on main. The repo has no formatter or linter, so this hook runs no other step.
# Skips silently on a branch that has no scripts/guard_main.sh (older checkout).
set -euo pipefail
guard="$(cd "$(dirname "$0")/.." && pwd -P)/scripts/guard_main.sh"
[ -f "$guard" ] || exit 0
. "$guard"
guard_main_commit
